---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import BaseLayout from "./Base.astro";
import SeriesPanel from "@/components/SeriesPanel.astro";
import { Icon } from "astro-icon/components";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, seriesId } = post.data;

const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await render(post);
---

<style>
  :root {
    --header-height-mobile: 16px;
    --header-height-desktop: 20px;
    --sidebar-width: 18rem; /* 288px, 默认侧边栏宽度 */
  }

  #custom-sidebar {
    position: fixed;
    top: var(--header-height-mobile);
    height: calc(100vh - var(--header-height-mobile));
    width: var(--sidebar-width);
    z-index: 40;
    overflow-y: auto;
    transition: all 0.3s ease-in-out;
    box-shadow: 5px 0px 10px rgba(0,0,0,0.05);
    background-color: var(--bgColor);
  }

  /* 为内容容器添加左边距，避免被侧边栏遮挡 */
  #main-content-wrapper {
    margin-left: var(--sidebar-width);
    width: calc(100% - var(--sidebar-width));
  }

  @media (min-width: 768px) {
    #custom-sidebar {
      top: var(--header-height-desktop);
      height: calc(100vh - var(--header-height-desktop));
    }
  }

  /* 当侧边栏隐藏时，移除内容区的边距 */
  #custom-sidebar.hidden + #main-content-wrapper {
    margin-left: 0;
    width: 100%;
  }

  /* 小屏幕上默认隐藏侧边栏 */
  @media (max-width: 1023px) {
    #custom-sidebar {
      transform: translateX(-100%);
    }
    #custom-sidebar.active {
      transform: translateX(0);
    }
    #main-content-wrapper {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class="fixed left-0 top-0 z-10 flex h-16 md:h-20 w-full bg-bgColor overflow-hidden">
		<!-- Background -->	
		<div class="absolute top-0 left-1/2 -ml-[50vw] w-screen min-h-screen pointer-events-none blur-2xl">
			<div class="absolute top-[-90%] right-[25%] w-[75%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-40 dark:opacity-5"></div>
			<div class="absolute top-[-90%] left-[25%] w-[75%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-40 dark:opacity-5"></div>
			<div class="absolute top-[-85%] right-[25%] w-[55%] h-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent rounded-full opacity-40 dark:opacity-5"></div>
			<div class="absolute top-[-85%] left-[25%] w-[55%] h-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent rounded-full opacity-40 dark:opacity-5"></div>
			<div class="absolute top-[-75%] left-[-25%] w-[65%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-30 dark:opacity-5"></div>
			<div class="absolute top-[-75%] right-[-25%] w-[65%] h-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent rounded-full opacity-30 dark:opacity-5"></div>
			<div class="absolute top-[-85%] left-[-30%] w-[85%] h-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent rounded-full opacity-60 dark:opacity-5"></div>
			<div class="absolute top-[-85%] right-[-30%] w-[85%] h-full bg-gradient-to-b from-orange-300 via-indigo-300 to-transparent rounded-full opacity-60 dark:opacity-5"></div>
		</div>
	</div>
 	
	<!-- SeriesPanel is inserted into the named slot "sidebar" -->
	<div slot="sidebar">
		<aside
			id="custom-sidebar"
			class="grid lg:block z-40 fixed top-[16px] md:top-[20px] h-[calc(100vh-16px)] md:h-[calc(100vh-20px)] overflow-y-auto shadow-[5px_0px_10px_rgba(0,0,0,0.05)] transition-all duration-300 ease-in-out bg-bgColor"
		>	
			<div class="fixed -z-10 top-0 w-full md:w-72 md:min-w-72 md:max-w-72 h-screen bg-gradient-to-b from-orange-300 via-pink-300 to-purple-300 opacity-30 dark:opacity-0">
			</div>
			
			<div class="flex h-full flex-col px-8 pt-4 md:pt-8 w-full md:w-72 md:min-w-72 md:max-w-72 bg-accent-base/5 border-r border-special-light">
				<div class="flex gap-x-1">
					<h4 class="flex items-center title mb-[4.5rem]">
						Sidebar
					</h4>
				</div>
				<button
					id="close-panel"
					class="absolute top-4 right-4 md:top-8 md:right-8 h-8 w-8 flex items-center justify-center rounded-lg bg-accent-base/5 text-accent-base hover:bg-accent-base/10"
					aria-label="Close Sidebar"
				>
					<Icon class="h-6 w-6" name="hugeicons:cancel-01" />
				</button>

				<!-- 侧边栏模块 1: 最近文章 -->
				<div class="mb-8">
					<h5 class="font-semibold text-accent-base mb-2">Recent Posts</h5>
					<ul class="text-sm font-medium text-light">
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/posts/introducing-astro-citrus/" class="hover:text-accent-two">
								Introducing Astro Citrus!
							</a>
						</li>
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/posts/citrus-docs/setup/" class="hover:text-accent-two">
								Setup Citrus
							</a>
						</li>
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/posts/citrus-docs/themes/" class="hover:text-accent-two">
								Flexible Theming System
							</a>
						</li>
					</ul>
				</div>

				<!-- 侧边栏模块 2: 分类 -->
				<div class="mb-8">
					<h5 class="font-semibold text-accent-base mb-2">Categories</h5>
					<ul class="text-sm font-medium text-light">
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/category/tutorials/" class="hover:text-accent-two">
								Tutorials
							</a>
						</li>
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/category/documentation/" class="hover:text-accent-two">
								Documentation
							</a>
						</li>
						<li class="px-2 py-1 hover:bg-color-100 rounded-lg">
							<a href="/category/updates/" class="hover:text-accent-two">
								Updates
							</a>
						</li>
					</ul>
				</div>

				<!-- 侧边栏模块 3: 标签 -->
				<div class="mb-8">
					<h5 class="font-semibold text-accent-base mb-2">Tags</h5>
					<div class="flex flex-wrap gap-2">
						<a href="/tags/astro/" class="px-2 py-1 text-xs rounded-full bg-color-100 hover:bg-color-150 text-accent">astro</a>
						<a href="/tags/javascript/" class="px-2 py-1 text-xs rounded-full bg-color-100 hover:bg-color-150 text-accent">javascript</a>
						<a href="/tags/tailwind/" class="px-2 py-1 text-xs rounded-full bg-color-100 hover:bg-color-150 text-accent">tailwind</a>
						<a href="/tags/markdown/" class="px-2 py-1 text-xs rounded-full bg-color-100 hover:bg-color-150 text-accent">markdown</a>
					</div>
				</div>
			</div>
		</aside>
	</div>

	<!-- 主内容区 -->
	<div id="main-content-wrapper" class="transition-all duration-300">
		<Masthead content={post} />
		
		<div class="mt-6 flex sm:grid-cols-[auto_1fr] md:items-start gap-x-8">
			<article class="grid flex-grow grid-cols-1 break-words pt-4" data-pagefind-body>
				<div class="prose prose-citrus max-w-none flex-grow prose-headings:font-semibold prose-headings:text-accent-base prose-headings:before:text-accent-two sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none">
					<slot />
				</div>
				<WebMentions />
			</article>
			{!!headings.length && (
				<>
					<!-- Mobile TOC Toggle Button -->
					<button
						id="toggle-toc-mobile"
						class="md:hidden fixed bottom-20 right-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-bgColor text-3xl drop-shadow-xl transition-all duration-300 hover:text-accent-two"
						aria-label="Toggle Table of Contents"
					>
						<Icon class="h-6 w-6" name="solar:list-bold" />
					</button>
					
					<!-- TOC Panel -->
					<aside 
						id="toc-panel" 
						class="md:sticky md:top-20 z-10 hidden md:w-[14rem] md:min-w-[14rem] md:rounded-lg md:block"
					>
						<TOC headings={headings} />
					</aside>
				</>
			)}
		</div>
	</div>

	<!-- 回到顶部按钮 -->
	<div class="fixed bottom-4 right-4 z-50">
		<button
			id="to-top-button"
			class="flex h-12 w-12 text-light translate-y-28 items-center justify-center rounded-full bg-bgColor text-3xl drop-shadow-xl transition-all duration-300 hover:text-accent-two data-[show=true]:translate-y-0 data-[show=true]:opacity-100"
			aria-label="Back to Top"
			data-show="false"
		>	
			<span class="absolute inset-0 rounded-full bg-special-lighter flex items-center justify-center" aria-hidden="true">
				<svg
					class="h-6 w-6"
					fill="none"
					focusable="false"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</span>
		</button>
	</div>
	
	<!-- 侧边栏切换按钮 -->
	<button
		id="toggle-panel-mobile"
		class="md:hidden fixed bottom-20 left-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-bgColor text-3xl drop-shadow-xl transition-all duration-300 hover:text-accent-two"
		aria-label="Toggle Sidebar"
	>
		<Icon class="h-6 w-6" name="solar:hamburger-menu-bold" />
	</button>
</BaseLayout>

<!-- Copy code button -->
<script>
	// 专门处理侧边栏和TOC功能
	document.addEventListener("DOMContentLoaded", () => {
		// -------- 侧边栏功能 --------
		const customSidebar = document.getElementById("custom-sidebar");
		const closeBtn = document.getElementById("close-panel");
		const toggleBtn = document.getElementById("toggle-panel-mobile");
		
		// 侧边栏自适应管理
		if (customSidebar) {
			// 小屏幕上默认隐藏，大屏幕上默认显示
			if (window.innerWidth < 1024) {
				customSidebar.classList.remove('active');
			} else {
				customSidebar.classList.add('active');
			}
			
			// 处理窗口大小变化
			window.addEventListener('resize', () => {
				if (window.innerWidth < 1024) {
					customSidebar.classList.remove('active');
				} else {
					customSidebar.classList.add('active');
				}
			});
		}
		
		// 关闭按钮功能
		if (closeBtn && customSidebar) {
			closeBtn.addEventListener('click', () => {
				customSidebar.classList.remove('active');
				console.log("关闭侧边栏");
			});
		}
		
		// 切换按钮功能(移动端)
		if (toggleBtn && customSidebar) {
			toggleBtn.addEventListener('click', () => {
				customSidebar.classList.toggle('active');
				console.log("切换侧边栏");
			});
		}
		
		// -------- 目录功能 --------
		const toggleTocMobile = document.getElementById('toggle-toc-mobile');
		const tocPanel = document.getElementById('toc-panel');
		
		if (toggleTocMobile && tocPanel) {
			toggleTocMobile.addEventListener('click', () => {
				tocPanel.classList.toggle('hidden');
				console.log("切换目录");
			});
		}
		
		// 回到顶部按钮
		const toTopButton = document.getElementById('to-top-button');
		if (toTopButton) {
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					toTopButton.setAttribute('data-show', 'true');
				} else {
					toTopButton.setAttribute('data-show', 'false');
				}
			});
			
			toTopButton.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});
		}
		
		// 其他按钮功能
		const buttonsPanel = document.getElementById("buttons-panel");
		if (buttonsPanel) {
			buttonsPanel.classList.add("fixed");
		}
		
		// 找到所有pre块并添加复制代码按钮
		document.querySelectorAll("pre").forEach((pre) => {
			if (!pre.querySelector(".copy-code")) {
				const copyButton = document.createElement("button");
				copyButton.className = "absolute flex items-center justify-center bg-bgColor h-6 font-medium overflow-hidden rounded-md text-light hover:text-accent-two font-sans text-sm font-medium top-2 right-2";

				const buttonText = document.createElement("span");
				buttonText.innerText = "Copy";
				buttonText.className = "flex items-center block w-full h-full px-2 bg-[var(--code-title-bg)]";

				copyButton.appendChild(buttonText);
				pre.appendChild(copyButton);

				copyButton.addEventListener("click", async () => {
					const code = pre.querySelector("code")?.textContent;
					if (code) {
						await navigator.clipboard.writeText(code);
						buttonText.innerText = "Copied!";
						setTimeout(() => {
							buttonText.innerText = "Copy";
						}, 1500);
					}
				});
			}
		});
	});
</script>

<script>
	const scrollBtn = document.getElementById("to-top-button") as HTMLButtonElement;
	const targetHeader = document.querySelector("header") as HTMLElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// Show the scroll to top button when the <header> is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
