</script>

<!-- Scroll to top button -->
<script>
	const scrollBtn = document.getElementById("to-top-button") as HTMLButtonElement;
	const targetHeader = document.querySelector("header") as HTMLElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// Show the scroll to top button when the <header> is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>

<!-- 移动端目录切换 -->
<script>
	// 移动端目录切换
	const toggleTocMobile = document.getElementById('toggle-toc-mobile');
	const tocPanel = document.getElementById('toc-panel');
	
	if (toggleTocMobile && tocPanel) {
		toggleTocMobile.addEventListener('click', () => {
			tocPanel.classList.toggle('hidden');
		});
	}

	// 回到顶部按钮
	const toTopButton = document.getElementById('to-top-button');
	if (toTopButton) {
		window.addEventListener('scroll', () => {
			if (window.scrollY > 300) {
				toTopButton.setAttribute('data-show', 'true');
			} else {
				toTopButton.setAttribute('data-show', 'false');
			}
		});

		toTopButton.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	}
</script>

<!-- 随机标签生成脚本 -->
<script>
	// 随机标签生成函数
	function generateRandomTags() {
		const tagsContainer = document.getElementById('random-tags');
		if (!tagsContainer) return;

		// 从data-tags属性获取所有可能的标签
		let allTags: string[] = [];
		try {
			allTags = JSON.parse(tagsContainer.getAttribute('data-tags') || '[]');
		} catch (e) {
			console.error('Error parsing tags:', e);
			return;
		}

		// 如果没有标签，显示提示信息
		if (!allTags.length) {
			tagsContainer.innerHTML = '<div class="text-lighter italic">No tags available</div>';
			return;
		}

		// 随机打乱标签顺序 - 使用Fisher-Yates算法
		for (let i = allTags.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[allTags[i], allTags[j]] = [allTags[j], allTags[i]];
		}

		// 选择前6个标签，或者如果标签总数少于6个，则全部显示
		const randomTags = allTags.slice(0, Math.min(12, allTags.length));
		
		// 清空现有内容
		tagsContainer.innerHTML = '';
		
		// 生成标签HTML
		randomTags.forEach((tag: string) => {
			const tagLink = document.createElement('a');
			tagLink.href = `/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`;
			tagLink.className = 'px-2 py-1 text-xs rounded-full bg-color-150 hover:bg-color-200 text-accent';
			tagLink.textContent = tag;
			tagsContainer.appendChild(tagLink);
		});
	}

	// 页面加载时生成随机标签
	document.addEventListener('DOMContentLoaded', generateRandomTags);
	
	// 可选：为标签容器添加点击事件，点击后重新随机
	document.getElementById('random-tags')?.addEventListener('click', function(e) {
		// 只有当点击的是容器背景时才重新随机（不是点击标签链接时）
		if (e.target === this) {
			generateRandomTags();
		}
	});
</script>
